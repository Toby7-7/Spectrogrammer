# Copy this file to `keystore.properties` (gitignored) for fixed Release APK signing.
# Do NOT commit real keystores or passwords to git.
#
# Generate a new release keystore once with:
#   keytool -genkeypair -v -keystore release.keystore -alias spectrogrammer -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=spectrogrammer
keyPassword=CHANGE_ME
